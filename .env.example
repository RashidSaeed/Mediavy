# Local/dev default — SQLite file, zero setup required.
DATABASE_URL="file:./dev.db"

# To point at a real Postgres/Supabase instance instead:
# 1. In prisma/schema.prisma, change datasource `provider` to "postgresql"
# 2. Set DATABASE_URL to your Postgres connection string, e.g.:
# DATABASE_URL="postgresql://user:password@host:5432/mediavy?schema=public"
# 3. Run: npx prisma migrate deploy && npx prisma db seed
